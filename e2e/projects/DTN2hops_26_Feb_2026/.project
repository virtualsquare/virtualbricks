[Image:debian13]
path=/home/carlo/VB_images/debian13.qcow2
description=

[Switch:sw1]

[Switch:sw2]

[Switch:sw3]

[Switch:sw4]

[SwitchWrapper:switchwrapper]
path=/var/run/switch/sck

[Switch:sw5]

[Netemu:channel_emulator]
#Syntax used by the old versions (only one state); added for backwards compatibility only

bandwidth=0
chanbufsize=0
delay=10

[Netemu:sat_channel_emulator]
#Syntax used by the old versions (only one state); added for backwards compatibility only

bandwidth=0
chanbufsize=0
delay=20

[Netemu:to_host_ch_emulator]
#Syntax used by the old versions (only one state); added for backwards compatibility only

bandwidth=0
chanbufsize=0
loss=5.0
losssymm=

[Qemu:node1]
argv0=qemu-system-x86_64
cdrom=/media/carlo/T7/Archivio/Zip/Debian/debian-12.6.0-amd64-netinst.iso
hda=debian13
keyboard=it
kvm=*
name=vm1
novga=*
privatehda=*
ram=1508
tdf=*
use_virtio=*

[Qemu:node2]
argv0=qemu-system-x86_64
hda=debian13
keyboard=it
kvm=*
name=vm1
novga=*
privatehda=*
ram=500
use_virtio=*

[Qemu:node3]
argv0=qemu-system-x86_64
hda=debian13
keyboard=it
kvm=*
name=vm1
novga=*
privatehda=*
ram=500
tdf=*
use_virtio=*

[Qemu:node4]
argv0=qemu-system-x86_64
hda=debian13
keyboard=it
kvm=*
name=vm1
novga=*
privatehda=*
ram=500
tdf=*
use_virtio=*

