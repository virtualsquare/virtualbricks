include COPYING LICENCE
include docs/redesign/*.html
include docs/build.py docs/README.md docs/man/*.md docs/guide/*.md
include docs/guide/figures/*.png docs/templates/* docs/built/man/*.[1-9]
include docs/built/mallard/*.page docs/built/mallard/figures/*.png
include docs/built/html/*.html docs/built/html/*.css
include docs/built/html/figures/*.png
include tools/*.py tools/*.sh
include locale/virtualbricks/virtualbricks.pot locale/virtualbricks/*.po
recursive-include share *
recursive-include virtualbricks/tests/data *.json *.py *.txt
recursive-include virtualbricks/tests/data/tls *.pem *.key *.md
